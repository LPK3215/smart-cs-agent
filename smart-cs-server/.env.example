DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Lightweight model for simple queries (leave empty to disable multi-model routing)
LIGHT_MODEL=
MAX_ITERATIONS=10
MEMORY_WINDOW=8
SUMMARY_THRESHOLD=16
MAX_INPUT_LENGTH=1000
RATE_LIMIT_PER_MIN=20
TOOL_TIMEOUT_SEC=30
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173

# Embedding (DashScope — get key from https://dashscope.console.aliyun.com/)
EMBEDDING_API_KEY=your-dashscope-api-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# Data source: "mock" (hardcoded demo data) or "real" (backend APIs — requires real_service.py)
DATA_SOURCE=mock
